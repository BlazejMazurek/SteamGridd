datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  email           String    @unique
  password        String
  createdAt       DateTime  @default(now())

  // Relacje
  // Ulubiony gatunek użytkownika
  favoriteGenreId Int?
  favoriteGenre   Genre?    @relation("UserFavoriteGenre", fields: [favoriteGenreId], references: [id])

  // 4 ulubione gry użytkownika (relacja wielu-do-wielu)
  favoriteGames   Game[]    @relation("UserFavoriteGames")

  reviews         Review[]
  library         UserGame[]
}

model Game {
  id          Int        @id @default(autoincrement())
  appId       Int        @unique
  title       String     @unique
  description String?
  releaseDate String?
  coverImage  String?
  createdAt   DateTime   @default(now())

  // Relacje
  developerId Int?
  developer   Developer? @relation(fields: [developerId], references: [id])

  publisherId Int?
  publisher   Publisher? @relation(fields: [publisherId], references: [id])

  genres      Genre[]    @relation("GameGenres")
  reviews     Review[]
  
  favoritedBy User[]     @relation("UserFavoriteGames")
  inLibraries UserGame[]
}

model Developer {
  id    Int    @id @default(autoincrement())
  name  String @unique
  games Game[]
}

model Publisher {
  id    Int    @id @default(autoincrement())
  name  String @unique
  games Game[]
}

model Genre {
  id                Int    @id @default(autoincrement())
  name              String @unique
  games             Game[] @relation("GameGenres")
  usersWithFavorite User[] @relation("UserFavoriteGenre")
}

model Review {
  id          Int      @id @default(autoincrement())
  rating      Float
  comment     String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameId      Int 
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model UserGame {
  id          Int     @id @default(autoincrement())
  userId      Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  gameId      Int
  game        Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  // Statusy / półki gracza
  isPlayed    Boolean @default(false)
  isCompleted Boolean @default(false)
  isLiked     Boolean @default(false)
  isQueued    Boolean @default(false)

  @@unique([userId, gameId])
}